# Copy to `.env` (gitignored) and fill in what you need. Shell exports override these.

# Google Books API key for the Published labels tab.
# Google Cloud Console -> enable "Books API" -> Credentials -> Create API key.
GOOGLE_BOOKS_API_KEY=

# LLM used for Lotaria's electronic reading.
WFA_LLM_PROVIDER=ollama
# Default model to preselect (must be installed, e.g. `ollama pull llama3.2`).
WFA_LLM_MODEL=
# Ollama server address.
OLLAMA_HOST=http://localhost:11434
